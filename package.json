{
  "name": "deplo",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "agent:assets": "bash scripts/build-agent-assets.sh",
    "build": "npm run build -w @deplo/web",
    "typecheck": "npm run typecheck -w @deplo/web",
    "test": "npm run test -w @deplo/web && cd agent && go test ./...",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "prisma generate --schema apps/web/prisma/schema.prisma",
    "format": "prettier --write 'apps/web/src/**/*.{ts,tsx,css}' apps/web/next.config.ts 'apps/web/tests/*.mjs' 'scripts/*.mjs'",
    "format:check": "prettier --check 'apps/web/src/**/*.{ts,tsx,css}' apps/web/next.config.ts 'apps/web/tests/*.mjs' 'scripts/*.mjs'",
    "lint": "npm run lint -w @deplo/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.9.9",
    "prisma": "^6.19.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
